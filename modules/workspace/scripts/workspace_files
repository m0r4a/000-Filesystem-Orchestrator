#!/usr/bin/env bash

# Now just gets the dirs and files and handles
# the case of having duplicate keys

set -euo pipefail

usage() {
    echo "Usage: $0 <directory_path>"
    echo "  directory_path: Must be an existing directory"
    exit 1
}

error_exit() {
    echo "Error: $1" >&2
    exit 1
}

check_dependencies() {
    local commands=(
        "/usr/bin/find"
        "/usr/bin/sort"
        "/bin/readlink"
        "/bin/sed"
    )
    for cmd in "${commands[@]}"; do
        [[ -x "$cmd" ]] || error_exit "Required command not found or not executable: $cmd"
    done
}

declare -a USED_KEYS=()
declare -a ORDER=()
declare -a VALUES=()

escape_json() {
    # Escape backslashes and quotes for JSON
    echo -n "$1" | /bin/sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

make_key() {
    # Get the key trimming the path
    local name="$1"
    local key
    
    if [[ "$name" == .* ]]; then
        local rest="${name#.}"
        if [[ "$rest" == *.* ]]; then
            key=".${rest%%.*}"
        else
            key=".$rest"
        fi
    else
        if [[ "$name" == *.* ]]; then
            key="${name%%.*}"
        else
            key="$name"
        fi
    fi
    echo "$key"
}

key_exists() {
    local seek="$1"
    for k in "${USED_KEYS[@]:-}"; do
        [[ "$k" == "$seek" ]] && return 0
    done
    return 1
}

add_pair() {
    local base_key="$1"
    local val="$2"
    local key="$base_key"

    # This handles the duplicate keys, might be interesting
    # adding like a prefix based on the directory or smth

    if key_exists "$key"; then
        local n=2
        while key_exists "${base_key}_$n"; do
            n=$((n + 1))
        done
        key="${base_key}_$n"
    fi

    USED_KEYS+=("$key")
    ORDER+=("$key")
    VALUES+=("$val")
}

find_all_files() {
    local target_dir="$1"
    local filename
    local key_base
    
    if /usr/bin/find "$target_dir" -type f -printf '%P\0' 2>/dev/null | /usr/bin/sort -z >/dev/null 2>&1; then
        while IFS= read -r -d $'\0' filepath; do
            [[ -n "$filepath" ]] || continue
            
            filename=$(basename "$filepath")
            key_base=$(make_key "$filename")
            add_pair "$key_base" "$filepath"
        done < <(/usr/bin/find "$target_dir" -type f -printf '%P\0' | /usr/bin/sort -z)
    else
        while IFS= read -r filepath; do
            [[ -n "$filepath" ]] || continue
            
            filename=$(basename "$filepath")
            key_base=$(make_key "$filename")
            add_pair "$key_base" "$filepath"
        done < <(/usr/bin/find "$target_dir" -type f -printf '%P\n' | /usr/bin/sort)
    fi
}

output_json() {
    if [[ ${#ORDER[@]} -eq 0 ]]; then
        echo "{}"
        return
    fi

    local first=1
    printf '{'
    
    for ((i=0; i<${#ORDER[@]}; i++)); do
        local key="${ORDER[$i]}"
        local value="${VALUES[$i]}"
        local escaped_key escaped_value
        
        escaped_key=$(escape_json "$key")
        escaped_value=$(escape_json "$value")

        [[ $first -eq 1 ]] && first=0 || echo -n ","
        echo -n $'\n  '
        printf '"%s": "%s"' "$escaped_key" "$escaped_value"
    done
    
    echo
    echo '}'
}

main() {
    [[ $# -eq 1 ]] || usage
    check_dependencies

    local input_path="$1"
    local target_path

    [[ -d "$input_path" ]] || error_exit "Path does not exist or is not a directory: $input_path"

    target_path=$(/bin/readlink -f "$input_path")
    
    find_all_files "$target_path"
    output_json
}

main "$@"
